# Salin ke .env. Ganti semua nilai contoh sebelum menjalankan Docker.
DB_NAME=portfolio
DB_USER=portfolio
DB_PASSWORD=replace-with-a-unique-long-random-database-password

# Buat secret acak minimal 32 karakter; jangan gunakan nilai contoh ini.
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters

# Akun owner pertama dibuat otomatis saat database masih kosong.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters

# false untuk lokal HTTP; true untuk produksi di belakang HTTPS.
COOKIE_SECURE=false

# Ubah menjadi 1 bila ada satu reverse proxy tepercaya di depan API.
TRUST_PROXY=0
